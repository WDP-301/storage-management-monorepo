# Mobile App Environment Variables
# Android emulator: http://10.0.2.2:3001/api/v1
# iOS simulator: http://localhost:3001/api/v1
# Real device: replace with your machine LAN IP, e.g. http://192.168.1.50:3001/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/v1

# Goong map tiles key — lấy ở https://account.goong.io, mục Map Key.
# KHÁC REST API key (GOONG_API_KEY của apps/api): key này chỉ dùng cho vector style URL của
# bản đồ trên host tiles.goong.io, không gọi được Geocode/Autocomplete/Direction.
# Để trống thì app vẫn chạy, chế độ Bản đồ hiện thông báo chưa cấu hình.
EXPO_PUBLIC_GOONG_MAPTILES_KEY=

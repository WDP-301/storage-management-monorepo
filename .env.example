# Root Monorepo & Docker Compose Environment Configuration

# PostgreSQL Port Mapping (5433 on host to avoid conflict with native PostgreSQL on 5432)
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=storage_management_db

# RustFS S3 Ports
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfspassword

# Application Ports
API_PORT=3001
WEB_PORT=3000

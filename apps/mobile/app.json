{
  "expo": {
    "name": "Storage Management",
    "slug": "storage-management-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "storage-management",
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Cho phép lưu mã QR thanh toán vào thư viện ảnh để bạn quét bằng app ngân hàng.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563eb",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép chọn ảnh để đính kèm vào yêu cầu hỗ trợ và biên bản kho.",
          "cameraPermission": "Cho phép chụp ảnh hiện trạng kho khi lập biên bản nhận/trả kho.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép dùng vị trí để tìm kho trống gần bạn.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.storage.management"
    },
    "android": {
      "package": "com.storage.management"
    }
  }
}

{
  "name": "storage-management-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Storage Management Monorepo — Mobile (Expo SDK 54) + Web (React 19 Vite) + API (NestJS + PostgreSQL + RustFS S3)",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @storage/api dev",
    "dev:web": "pnpm --filter @storage/web dev",
    "dev:mobile": "pnpm --filter @storage/mobile dev",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @storage/api build",
    "build:web": "pnpm --filter @storage/web build",
    "turbo:build": "turbo run build",
    "turbo:lint": "turbo run lint",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "storage:up": "docker compose up -d postgres rustfs",
    "storage:down": "docker compose down",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:logs": "docker compose logs -f postgres",
    "s3:up": "docker compose up -d rustfs",
    "s3:down": "docker compose stop rustfs",
    "s3:logs": "docker compose logs -f rustfs",
    "clean": "pnpm -r exec rm -rf dist build .turbo && rm -rf .turbo",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "lefthook": "^2.1.14",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3"
  }
}

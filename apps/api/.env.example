PORT=3001
NODE_ENV=development

# PostgreSQL Database Configuration (Render)
# Copy host/user/password/database out of your Render connection string.
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
# Keep false in real environments — use `pnpm migration:run` instead of schema sync
DB_SYNCHRONIZE=false
DB_LOGGING=false
# Render and most managed Postgres require SSL
DB_SSL=true 

# App Features
ENABLE_SWAGGER=true
ENABLE_CORS=true
# Comma-separated allowed origins for credentialed CORS
CORS_ORIGINS=http://localhost:3000

# Cookie-based auth sessions (opaque token; only its SHA-256 hash is stored in `sessions`)
SESSION_COOKIE_NAME=sid
# Session lifetime in milliseconds (default 7 days)
SESSION_TTL_MS=604800000
# Set true when served over HTTPS
COOKIE_SECURE=false
# SameSite for the session cookie: only `lax` or `strict` are supported.
# WARNING: `none` is intentionally NOT supported — cross-site cookies require HTTPS AND
# CSRF protection (Origin/Referer check or CSRF token), which this API does not implement yet.
# Setting `none` (or any other value) falls back to `lax`.
COOKIE_SAME_SITE=lax

# S3-compatible Object Storage (Cloudflare R2)
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=true
# Public URL base for file links (R2: pub-<hash>.r2.dev or custom domain).
# Optional — defaults to <S3_ENDPOINT>/<S3_BUCKET>
S3_PUBLIC_URL=

PORT=3001
NODE_ENV=development

# PostgreSQL Database Configuration
# Use DB_PORT=5433 when connecting to Docker PostgreSQL container from host
# Use DB_PORT=5432 if connecting to host native PostgreSQL service
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_DATABASE=storage_management_db
# Keep false in real environments — use `pnpm migration:run` instead of schema sync
DB_SYNCHRONIZE=false
DB_LOGGING=false

# App Features
ENABLE_SWAGGER=true
ENABLE_CORS=true
# Comma-separated allowed origins for credentialed CORS
CORS_ORIGINS=http://localhost:3000

# S3 Object Storage (RustFS)
# API port: 9000 | Web Console: 9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfspassword
S3_BUCKET=storage-management-bucket
S3_FORCE_PATH_STYLE=true

{
  "name": "storage-management-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Storage Management Monorepo — Mobile (Expo) + Web (Next.js) + API (NestJS + PostgreSQL)",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @storage/api dev",
    "dev:web": "pnpm --filter @storage/web dev",
    "dev:mobile": "pnpm --filter @storage/mobile dev",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @storage/api build",
    "build:web": "pnpm --filter @storage/web build",
    "turbo:build": "turbo run build",
    "turbo:lint": "turbo run lint",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "lefthook": "^1.11.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}

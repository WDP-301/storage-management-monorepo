{
  "name": "@storage/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Storage Management Web Dashboard (React 19 + Vite 8 + Tailwind CSS 4)",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc && vite build",

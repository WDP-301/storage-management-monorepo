{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storage-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
